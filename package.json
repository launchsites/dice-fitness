{
  "name": "exercise-dice-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:app": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.38.2",
    "luxon": "^3.7.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
